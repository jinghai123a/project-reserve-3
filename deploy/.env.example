COMPOSE_PROJECT_NAME=cloudkit
# Required: for company-managed projects, set BOTH to the same business owner/repository.
# Do not use the company headquarters, rules, or runtime repository as a business project/state store.
CLOUDKIT_CONTROL_REPOSITORY=
CLOUDKIT_PROJECT_REPOSITORY=
CLOUDKIT_PROJECT_BRANCH=main
# Empty means resolve the exact current project branch SHA during preparation.
CLOUDKIT_SOURCE_SHA=
# Empty means use the model from the authenticated Codex configuration.
CLOUDKIT_MODEL=
# Use the public distribution's bundled role configuration, independent of project state.
CLOUDKIT_AGENT_CONFIG_SOURCE=/opt/cloudkit/deploy/company-rules/.codex
CODEX_VERSION=0.162.1
CLOUDKIT_IMAGE_TAG=cloud-upgrade
CLOUDKIT_PROBE_TIMEOUT=90
CLOUDKIT_CPU_LIMIT=2
CLOUDKIT_MEMORY_LIMIT=4g
# Relative to repository root. This file must exist and be readable by UID 1000.
CLOUDKIT_GITHUB_TOKEN_FILE=./deploy/secrets/github_token
